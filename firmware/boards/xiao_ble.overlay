/*
 * Life Pager Rev A wiring on the Seeed XIAO nRF52840. Keep in step with hardware/netlist.yaml.
 *
 *   D0 P0.02 BTN_UP      D4 P0.04 MODEM_DTR    D8  P1.13 LCD_SCK
 *   D1 P0.03 BTN_SEL     D5 P0.05 MODEM_RI     D9  P1.14 LCD_CS (active high)
 *   D2 P0.28 BTN_DOWN    D6 P1.11 UART_TX      D10 P1.15 LCD_MOSI
 *   D3 P0.29 MODEM_EN    D7 P1.12 UART_RX      NFC1 P0.09 HAPTIC
 *   on-board: P0.31 battery sense (AIN7), P0.14 sense enable (low), P0.13 charge current
 */
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,display = &lcd;
	};

	buttons {
		compatible = "gpio-keys";
		btn_up: btn_up {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_UP>;
		};
		btn_sel: btn_sel {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
		btn_down: btn_down {
			gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_DOWN>;
		};
	};

	zephyr,user {
		haptic-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		modem-en-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		modem-dtr-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		modem-ri-gpios = <&gpio0 5 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
		vbat-en-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		charge-fast-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
		io-channels = <&adc 7>;
	};
};

&uicr {
	nfct-pins-as-gpios;
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};

&pinctrl {
	lcd_spi_default: lcd_spi_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, <NRF_PSEL(SPIM_MOSI, 1, 15)>;
		};
	};
	lcd_spi_sleep: lcd_spi_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>, <NRF_PSEL(SPIM_MOSI, 1, 15)>;
			low-power-enable;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&lcd_spi_default>;
	pinctrl-1 = <&lcd_spi_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;

	lcd: ls0xx@0 {
		compatible = "sharp,ls0xx";
		reg = <0>;
		spi-max-frequency = <2000000>;
		width = <168>;
		height = <144>;
		/* EXTMODE is tied low: the driver toggles VCOM in software */
	};
};

/* uart0 is already on D6 (TX) / D7 (RX) in the board file; it talks to the nRF9151 */
&uart0 {
	status = "okay";
	current-speed = <115200>;
};

/* I2C and the default SPI flash are not used; their pins are reassigned above */
&i2c1 {
	status = "disabled";
};
