# Public https URL Twilio can reach (no trailing slash). Signatures are checked against it.
PUBLIC_URL=https://pager.example.com
PORT=8080
DB_PATH=/data/pager.db
# Long random string shared with the iPhone app (openssl rand -hex 24)
APP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number your carrier forwards unanswered calls to, E.164
TWILIO_NUMBER=+15550000000
# LTE path (leave MQTT_URL empty for Bluetooth-only builds)
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USER=backend
MQTT_PASS=
PAGER_ID=pager1
